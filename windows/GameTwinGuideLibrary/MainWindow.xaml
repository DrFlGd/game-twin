<Window x:Class="GameTwinGuideLibrary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Game Guide Library — Windows"
        Width="1510" Height="870" MinWidth="1100" MinHeight="640"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="69"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="GAME GUIDE LIBRARY" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Explore original sources and browse Game Twin's bundled indexes"
                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Center"
                        Background="{StaticResource PanelAltBrush}" CornerRadius="5" Padding="10,6">
                    <TextBlock Text="PHASE 1  •  BROWSE ONLINE" FontSize="11"
                               Foreground="{StaticResource MutedBrush}"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="448"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Saved game names -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="MY GAMES" FontSize="12" FontWeight="Bold" Margin="2,4,0,14"
                               Foreground="{StaticResource MutedBrush}"/>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="7"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GameNameInput" ToolTip="Enter a game title" KeyDown="GameNameInput_KeyDown"/>
                        <Button Grid.Column="2" Content="Add" Click="AddGame_Click"/>
                    </Grid>
                    <ListBox Grid.Row="2" x:Name="GamesListBox"
                             SelectionChanged="GamesListBox_SelectionChanged"/>
                    <StackPanel Grid.Row="3">
                        <Button Content="Remove selected game" Click="RemoveGame_Click"
                                HorizontalAlignment="Stretch" Margin="0,12,0,10"/>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Saved game names only" FontWeight="SemiBold" FontSize="12"/>
                                <TextBlock Text="Phase 1 stores your game list. Guides remain on their publishers' websites until archiving is added."
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Discover + entire bundled catalog browser -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <TabControl x:Name="DiscoveryTabs" Margin="5">
                    <TabItem Header="For this game">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="SelectedGameHeading" Text="Choose a game"
                                       FontSize="17" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,8,0,8"/>
                            <TextBlock Grid.Row="1" Text="SOURCE SHORTCUTS" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" FontWeight="Bold" Margin="0,4,0,7"/>
                            <ListBox x:Name="SourceShortcutsList" Grid.Row="2" Height="188"
                                     MouseDoubleClick="SourceShortcutsList_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,0">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="3" x:Name="MatchedGuidesHeading"
                                       Text="MATCHES IN BUNDLED CATALOGS" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" FontWeight="Bold" Margin="0,16,0,8"/>
                            <ListBox x:Name="MatchesList" Grid.Row="4"
                                     MouseDoubleClick="MatchesList_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="5" Content="Open selected resource" Click="OpenSelectedResource_Click"
                                    HorizontalAlignment="Stretch" Margin="0,12,0,4"/>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Browse all catalogs">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,8,0,12">
                                <TextBlock Text="BUNDLED RESOURCE INDEX" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock x:Name="CatalogSummary" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                            <ComboBox x:Name="CatalogSourceCombo" Grid.Row="1" Height="35"
                                      DisplayMemberPath="Name" SelectionChanged="CatalogSourceCombo_SelectionChanged"
                                      Background="{StaticResource PanelAltBrush}"
                                      Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                            <TextBox x:Name="CatalogSearchBox" Grid.Row="2"
                                     TextChanged="CatalogSearchBox_TextChanged"
                                     ToolTip="Search any game or resource in the selected catalog"
                                     Margin="0,0,0,12"/>
                            <ListBox x:Name="CatalogEntriesList" Grid.Row="3"
                                     MouseDoubleClick="CatalogEntriesList_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                       FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="4" Margin="0,12,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CatalogPreviousButton" Content="Previous"
                                        Click="CatalogPrevious_Click"/>
                                <TextBlock x:Name="CatalogPageInfo" Grid.Column="1"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                <Button x:Name="CatalogNextButton" Grid.Column="2" Content="Next"
                                        Click="CatalogNext_Click"/>
                            </Grid>
                            <Button Grid.Row="5" Content="Open selected catalog entry"
                                    Click="OpenSelectedResource_Click" HorizontalAlignment="Stretch"/>
                        </Grid>
                    </TabItem>

                    <!-- IGN navigation is not a recursive crawler: reads the
                         full __NEXT_DATA__.props.pageProps.page.navigation tree. -->
                    <TabItem Header="IGN sidebar">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="IGN WIKI DIRECTORY" FontSize="15" FontWeight="SemiBold"
                                       Margin="0,8,0,5"/>
                            <TextBlock x:Name="IgnDirectorySummary" Grid.Row="1"
                                       Text="Open an IGN wiki, then choose Discover IGN sidebar."
                                       TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,12"/>
                            <TextBox x:Name="IgnPageSearchBox" Grid.Row="2"
                                     ToolTip="Filter the IGN sidebar by article title"
                                     TextChanged="IgnPageSearchBox_TextChanged"
                                     Margin="0,0,0,8"/>
                            <ComboBox x:Name="IgnSectionCombo" Grid.Row="3"
                                      Height="34" Margin="0,0,0,8"
                                      SelectionChanged="IgnSectionCombo_SelectionChanged"
                                      Background="{StaticResource PanelAltBrush}"
                                      Foreground="{StaticResource TextBrush}"/>
                            <Grid Grid.Row="4" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Select all" Click="IgnSelectAll_Click"
                                        ToolTip="Select every article from the sidebar"/>
                                <Button Grid.Column="2" Content="Select visible" Click="IgnSelectVisible_Click"
                                        ToolTip="Select the filtered articles"/>
                                <Button Grid.Column="4" Content="Clear" Click="IgnClearSelection_Click"/>
                            </Grid>
                            <ListBox x:Name="IgnPagesList" Grid.Row="5"
                                     MouseDoubleClick="IgnPagesList_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="1,3">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Foreground="{StaticResource TextBrush}"
                                                      VerticalContentAlignment="Center">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           TextWrapping="Wrap" FontSize="12"/>
                                            </CheckBox>
                                            <TextBlock Text="{Binding Section}"
                                                       Margin="22,2,0,0" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ProgressBar x:Name="IgnArchiveProgress" Grid.Row="6"
                                         Height="6" Minimum="0" Maximum="1"
                                         Margin="0,12,0,7"/>
                            <TextBlock x:Name="IgnArchiveProgressLabel" Grid.Row="7"
                                       Text="No archive running."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Grid Grid.Row="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="IgnSaveSelectedButton" Content="Archive selected IGN pages"
                                        Click="IgnSaveSelected_Click" HorizontalAlignment="Stretch"/>
                                <Button x:Name="IgnCancelButton" Grid.Column="2" Content="Cancel"
                                        IsEnabled="False" Click="IgnCancel_Click"/>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Saved IGN">
                        <Grid Margin="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="IgnSavedSummary" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,8,0,12"/>
                            <ListBox x:Name="IgnSavedList" Grid.Row="1"
                                     MouseDoubleClick="IgnSavedList_DoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,3">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Summary}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Grid.Row="2" Margin="0,12,0,8">
                                <Button Content="Read offline" Click="IgnReadOffline_Click" Margin="0,0,6,6"/>
                                <Button Content="Open source" Click="IgnSavedOpenOriginal_Click" Margin="0,0,6,6"/>
                                <Button Content="Show in folder" Click="IgnShowInFolder_Click" Margin="0,0,6,6"/>
                                <Button Content="Refresh" Click="IgnRefreshSaved_Click" Margin="0,0,0,6"/>
                            </WrapPanel>
                            <TextBlock Grid.Row="3" Text="Read offline opens the cleaned guide view by default. Use Reader: On/Off above the browser to switch layouts, or export a separate clean MHTML. Original archives remain unchanged. Failed pages can be retried."
                                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Website viewer -->
            <Border Grid.Column="4" Background="{StaticResource PanelBrush}"
                    CornerRadius="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="4,4,4,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackButton" Content="←" Click="Back_Click" Width="36" ToolTip="Back"/>
                        <Button Grid.Column="1" x:Name="ForwardButton" Content="→" Click="Forward_Click"
                                Width="36" Margin="5,0,0,0" ToolTip="Forward"/>
                        <Button Grid.Column="2" Content="↻" Click="Reload_Click"
                                Width="36" Margin="5,0,0,0" ToolTip="Refresh"/>
                        <TextBox x:Name="AddressBox" Grid.Column="3" Margin="9,0,6,0"
                                 KeyDown="AddressBox_KeyDown"/>
                        <Button Grid.Column="4" Content="Go" Click="Go_Click" Margin="0,0,6,0"/>
                        <Button Grid.Column="5" Content="External ↗" Click="OpenExternal_Click"
                                ToolTip="Open this page in your default browser"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="8,0,8,8">
                        <TextBlock x:Name="ResourceTitleText"
                                   Text="Choose a source or catalog entry to start browsing."
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/>
                        <WrapPanel>
                            <Button x:Name="IgnSaveCurrentButton" Content="Save IGN page"
                                    Click="IgnSaveCurrent_Click" Margin="0,0,7,0"/>
                            <Button x:Name="IgnDiscoverButton" Content="Discover IGN sidebar"
                                    Click="IgnDiscover_Click" Margin="0,0,7,0"/>
                            <Button Content="View saved IGN" Click="IgnViewSaved_Click" Margin="0,0,8,0"/>
                            <Button x:Name="IgnReaderToggleButton" Content="Reader: On"
                                    IsEnabled="False" Click="IgnReaderToggle_Click" Margin="0,0,7,0"
                                    ToolTip="Switch between simplified guide content and the original MHTML layout"/>
                            <Button x:Name="IgnExportCleanButton" Content="Export clean MHTML"
                                    IsEnabled="False" Click="IgnExportClean_Click"
                                    ToolTip="Create a separate standalone reader-only MHTML; preserves the original archive"/>
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Row="2" Background="White" CornerRadius="3">
                        <wv2:WebView2 x:Name="GuideBrowser"/>
                    </Border>
                    <TextBlock Grid.Row="3" x:Name="BrowserStatusText" Text="Initializing browser…"
                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Margin="8,8,8,2" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="IGN: save individual pages or selected sidebar articles locally as MHTML."
                           FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="IGN offline archiving: Phases 2–3"
                           FontSize="11" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
